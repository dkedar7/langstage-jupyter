{
  "name": "langstage-jupyter-ui-tests",
  "version": "0.1.0",
  "description": "Galata UI tests for langstage-jupyter (not published)",
  "private": true,
  "scripts": {
    "start": "jupyter lab --config jupyter_server_test_config.py",
    "start:base-url": "jupyter lab --config jupyter_server_test_config.py --ServerApp.port=8889 --ServerApp.base_url=/user/alice/ --ServerApp.disable_check_xsrf=False",
    "test": "jlpm playwright test",
    "test:update": "jlpm playwright test --update-snapshots",
    "test:debug": "PWDEBUG=1 jlpm playwright test"
  },
  "devDependencies": {
    "@jupyterlab/galata": "^5.0.0",
    "@playwright/test": "^1.40.0"
  }
}
